# Copy to .env and fill in. .env is git-ignored.

# uid/gid the container runs as. Must be able to read config.json and
# every file under ./secrets/ (check with `id -u` / `id -g` and `ls -ln`).
PUID=1000
PGID=1000

# Tokens for requesters that use "token_env" in config.json.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WOL_TOKEN_PHONE=
