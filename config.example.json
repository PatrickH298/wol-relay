{
  "bind_host": "0.0.0.0",
  "bind_port": 8098,
  "targets": {
    "desktop": {
      "mac": "aa:bb:cc:dd:ee:01",
      "broadcast_address": "10.30.10.255",
      "source_address": "10.30.10.5"
    },
    "nas": {
      "mac": "aa:bb:cc:dd:ee:02",
      "broadcast_address": "10.30.20.255",
